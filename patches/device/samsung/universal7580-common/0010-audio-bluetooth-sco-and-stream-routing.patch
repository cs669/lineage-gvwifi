+// IBluetooth for the primary module. audioserver turns the BT stack's SCO
+// settings into setScoConfig(); the legacy HAL reads them as parameters.
+class LegacyBluetooth : public BnBluetooth {
+  public:
+    explicit LegacyBluetooth(audio_hw_device_t* device) : mDevice(device) {}
+
+    ndk::ScopedAStatus setScoConfig(const ScoConfig& in_config,
+                                    ScoConfig* _aidl_return) override {
+        if (in_config.isEnabled.has_value()) {
+            mScoConfig.isEnabled = in_config.isEnabled;
+        }
+        if (in_config.isNrecEnabled.has_value()) {
+            mScoConfig.isNrecEnabled = in_config.isNrecEnabled;
+            set(in_config.isNrecEnabled->value ? "bt_headset_nrec=on"
+                                                : "bt_headset_nrec=off");
+        }
+        if (in_config.mode != ScoConfig::Mode::UNSPECIFIED) {
+            mScoConfig.mode = in_config.mode;
+            set(in_config.mode == ScoConfig::Mode::SCO ? "bt_wbs=off" : "bt_wbs=on");
+        }
+        if (in_config.debugName.has_value()) {
+            mScoConfig.debugName = in_config.debugName;
+        }
+        *_aidl_return = mScoConfig;
+        LOG(INFO) << __func__ << ": " << mScoConfig.toString();
+        return ndk::ScopedAStatus::ok();
+    }
+
+    ndk::ScopedAStatus setHfpConfig(const HfpConfig& in_config,
+                                    HfpConfig* _aidl_return) override {
+        if (in_config.isEnabled.has_value()) mHfpConfig.isEnabled = in_config.isEnabled;
+        if (in_config.sampleRate.has_value()) mHfpConfig.sampleRate = in_config.sampleRate;
+        if (in_config.volume.has_value()) mHfpConfig.volume = in_config.volume;
+        *_aidl_return = mHfpConfig;
+        return ndk::ScopedAStatus::ok();
+    }
+
+  private:
+    void set(const char* kv) {
+        if (mDevice && mDevice->set_parameters) mDevice->set_parameters(mDevice, kv);
+    }
+
+    audio_hw_device_t* mDevice;
+    ScoConfig mScoConfig;
+    HfpConfig mHfpConfig;
+};
