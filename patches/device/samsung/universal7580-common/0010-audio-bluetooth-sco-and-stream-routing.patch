 ndk::ScopedAStatus Module::disconnectExternalDevice(int32_t in_portId) {
+    auto portIt = std::find_if(mTopologyPorts.begin(), mTopologyPorts.end(),
+                               [&](const auto& port) { return port.id == in_portId; });
+    if (portIt == mTopologyPorts.end() || in_portId < 1000) {
+        LOG(ERROR) << __func__ << ": port id " << in_portId << " is not a connected device";
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+    }
+    mTopologyPorts.erase(portIt);
+    mTopologyRoutes.erase(std::remove_if(mTopologyRoutes.begin(), mTopologyRoutes.end(),
+                                         [&](const auto& r) { return r.sinkPortId == in_portId; }),
+                          mTopologyRoutes.end());
+    for (auto& route : mTopologyRoutes) {
+        auto& src = route.sourcePortIds;
+        src.erase(std::remove(src.begin(), src.end(), in_portId), src.end());
+    }
+    mTopologyPortConfigs.erase(
+            std::remove_if(mTopologyPortConfigs.begin(), mTopologyPortConfigs.end(),
+                           [&](const auto& cfg) { return cfg.portId == in_portId; }),
+            mTopologyPortConfigs.end());
+    LOG(INFO) << __func__ << ": removed port " << in_portId;
     return ndk::ScopedAStatus::ok();
 }
 
