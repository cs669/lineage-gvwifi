diff --git a/hardware/audio/aidl-bluetooth/service.cpp b/hardware/audio/aidl-bluetooth/service.cpp
new file mode 100644
index 0000000..d8619e5
--- /dev/null
+++ b/hardware/audio/aidl-bluetooth/service.cpp
@@ -0,0 +1,44 @@
+/*
+ * Bluetooth audio for the universal7580 AIDL audio HAL.
+ *
+ * The primary HAL (android.hardware.audio.service.universal7580) only registers
+ * IModule/default. This separate service registers AOSP's reference Bluetooth
+ * module as IModule/bluetooth (A2DP and hearing-aid output for audioserver). The
+ * module's constructor also starts AOSP's Bluetooth audio provider
+ * (IBluetoothAudioProviderFactory/default), which the Bluetooth stack uses for the
+ * software A2DP data path.
+ */
+
+#define LOG_TAG "audio_bt_aidl_service"
+
+#include <android-base/logging.h>
+#include <android/binder_manager.h>
+#include <android/binder_process.h>
+
+#include "core-impl/Configuration.h"
+#include "core-impl/Module.h"
+
+using aidl::android::hardware::audio::core::IModule;
+using aidl::android::hardware::audio::core::Module;
+using aidl::android::media::audio::common::AudioPort;
+
+int main() {
+    ABinderProcess_setThreadPoolMaxThreadCount(8);
+    ABinderProcess_startThreadPool();
+
+    // Module::createInstance(type) alone passes an empty configuration, which
+    // leaves the module with no ports; pass the reference Bluetooth ports.
+    auto module = Module::createInstance(
+            Module::Type::BLUETOOTH,
+            aidl::android::hardware::audio::core::internal::getConfiguration(
+                    Module::Type::BLUETOOTH));
+    CHECK(module != nullptr);
+    std::vector<AudioPort> ports;
+    std::static_pointer_cast<IModule>(module)->getAudioPorts(&ports);
+    const std::string instance = std::string() + Module::descriptor + "/bluetooth";
+    CHECK_EQ(AServiceManager_addService(module->asBinder().get(), instance.c_str()), STATUS_OK);
+    LOG(INFO) << "started " << instance << " with " << ports.size() << " ports";
+
+    ABinderProcess_joinThreadPool();
+    return EXIT_FAILURE;  // should not reach
+}
