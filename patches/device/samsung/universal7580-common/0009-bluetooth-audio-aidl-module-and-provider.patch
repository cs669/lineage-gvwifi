diff --git a/hardware/audio/aidl-bluetooth/android.hardware.audio.service.bluetooth.universal7580.rc b/hardware/audio/aidl-bluetooth/android.hardware.audio.service.bluetooth.universal7580.rc
new file mode 100644
index 0000000..93fb69a
--- /dev/null
+++ b/hardware/audio/aidl-bluetooth/android.hardware.audio.service.bluetooth.universal7580.rc
@@ -0,0 +1,14 @@
+service vendor.audio-hal-bluetooth /vendor/bin/hw/android.hardware.audio.service.bluetooth.universal7580
+    class hal
+    interface aidl android.hardware.audio.core.IModule/bluetooth
+    interface aidl android.hardware.bluetooth.audio.IBluetoothAudioProviderFactory/default
+    user audioserver
+    group audio media net_bt net_bt_admin wakelock
+    capabilities BLOCK_SUSPEND SYS_NICE
+    onrestart restart audioserver
+
+# audioserver.rc restarts the stock audio HAL services when audioserver dies, but
+# not this one; restart it too, or it keeps the old A2DP connection and audioserver
+# can't connect the device again ("already connected").
+on property:init.svc.audioserver=restarting
+    restart vendor.audio-hal-bluetooth
