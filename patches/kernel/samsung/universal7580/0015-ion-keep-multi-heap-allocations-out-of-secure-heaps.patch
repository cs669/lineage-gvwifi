diff --git a/drivers/staging/android/ion/ion.c b/drivers/staging/android/ion/ion.c
index 8c317ba2..2c7243e1 100644
--- a/drivers/staging/android/ion/ion.c
+++ b/drivers/staging/android/ion/ion.c
@@ -751,6 +751,16 @@ static struct ion_handle *__ion_alloc(struct ion_client *client, size_t len,
 		/* if the caller didn't specify this heap id */
 		if (!((1 << heap->id) & heap_id_mask))
 			continue;
+		/*
+		 * A request that names several heaps (Codec2's ION allocator
+		 * asks for ~0) must not land in a secure heap: one unprotected
+		 * buffer left there makes every later protected allocation
+		 * fail, so secure (DRM) video decoding can't start.
+		 */
+		if (!(flags & ION_FLAG_PROTECTED) &&
+		    (heap_id_mask & ~(1 << heap->id)) &&
+		    ion_heap_is_secure(heap))
+			continue;
 		buffer = ion_buffer_create(heap, dev, len, align, flags);
 		if (!IS_ERR(buffer))
 			break;
